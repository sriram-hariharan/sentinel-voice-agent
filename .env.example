# SentinelVoice application
SENTINELVOICE_APP_NAME="SentinelVoice API"
SENTINELVOICE_ENVIRONMENT="development"

# PostgreSQL
SENTINELVOICE_DB_HOST="localhost"
SENTINELVOICE_DB_PORT=5432
SENTINELVOICE_DB_NAME="sentinelvoice"
SENTINELVOICE_DB_USER="sentinelvoice_db_user"
SENTINELVOICE_DB_PASSWORD=

# Groq
GROQ_API_KEY=
SENTINELVOICE_LLM_MODEL="openai/gpt-oss-20b"

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SENTINELVOICE_LIVEKIT_AGENT_NAME="sentinelvoice"
SENTINELVOICE_API_BASE_URL="http://127.0.0.1:8000"

# Voice providers
SENTINELVOICE_STT_MODEL="whisper-large-v3-turbo"
SENTINELVOICE_TTS_MODEL="canopylabs/orpheus-v1-english"
SENTINELVOICE_TTS_VOICE="hannah"

# Synthetic demo authentication
SENTINELVOICE_DEMO_PIN=
