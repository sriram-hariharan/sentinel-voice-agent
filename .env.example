# SentinelVoice application
SENTINELVOICE_APP_NAME="SentinelVoice API"
SENTINELVOICE_ENVIRONMENT="development"

# PostgreSQL
SENTINELVOICE_DB_HOST="localhost"
SENTINELVOICE_DB_PORT=5432
SENTINELVOICE_DB_NAME="sentinelvoice"
SENTINELVOICE_DB_USER="sentinelvoice_db_user"
SENTINELVOICE_DB_PASSWORD=

# Groq
GROQ_API_KEY=
SENTINELVOICE_LLM_MODEL="openai/gpt-oss-20b"

# Local policy embeddings and retrieval
SENTINELVOICE_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
SENTINELVOICE_EMBEDDING_DIMENSIONS=384
SENTINELVOICE_POLICY_RETRIEVAL_TOP_K=5
SENTINELVOICE_POLICY_RETRIEVAL_MIN_SIMILARITY=0.70
# Optional persistent FastEmbed model cache location
SENTINELVOICE_FASTEMBED_CACHE_DIR=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SENTINELVOICE_LIVEKIT_AGENT_NAME="sentinelvoice"
SENTINELVOICE_VOICE_TOKEN_TTL_SECONDS=600
SENTINELVOICE_API_BASE_URL="http://127.0.0.1:8000"

# Voice providers
SENTINELVOICE_STT_MODEL="whisper-large-v3-turbo"
SENTINELVOICE_TTS_MODEL="canopylabs/orpheus-v1-english"
SENTINELVOICE_TTS_VOICE="hannah"

# Synthetic demo authentication
SENTINELVOICE_DEMO_PIN=

# Bounded public/demo usage
SENTINELVOICE_DEMO_SESSION_TTL_SECONDS=900
SENTINELVOICE_DEMO_MAX_TURNS_PER_SESSION=30
SENTINELVOICE_DEMO_MAX_ACTIVE_SESSIONS=20
