{
  "architecture_decision": {
    "alternatives_rejected": [
      {
        "alternative": "evaluate_one_cross_validation_fold_model",
        "reason": "An arbitrary fold model omits development records and is not the classifier frozen by Step 22C."
      },
      {
        "alternative": "ensemble_cross_validation_models",
        "reason": "An ensemble was not selected or frozen by the development-only experiment."
      },
      {
        "alternative": "retune_or_reselect_after_holdout_results",
        "reason": "Post-holdout tuning or reselection would invalidate the final evidence."
      },
      {
        "alternative": "repeat_evaluation_after_failure_analysis",
        "reason": "A second clean claim after inspecting final failures would violate the once-only holdout boundary."
      }
    ],
    "chosen": "one_uncompromised_evaluation_of_the_step22c_frozen_model",
    "problem": "The selected development configuration has been fit once on all frozen development data but has no unbiased final evidence for the expanded taxonomy.",
    "reversibility": "High before holdout access; after access begins, this experiment cannot regain once-only clean-holdout status.",
    "tradeoffs": [
      "The balanced synthetic holdout does not estimate production prevalence.",
      "Forty examples per intent provide finite metric resolution.",
      "A crash after access prevents an automatic replacement run from being treated as the same final experiment.",
      "Passing final safety gates still does not grant runtime authority."
    ]
  },
