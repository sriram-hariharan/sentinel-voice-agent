{
  "architecture_decision": {
    "alternatives_rejected": [
      {
        "alternative": "reuse_v2c4_final_holdout",
        "reason": "The V2-C4 holdout covers only the historical nine-intent taxonomy and is invalid final evidence for the expanded label space."
      },
      {
        "alternative": "sample_step21b_development",
        "reason": "Sampling development data would leak training examples and their historical distribution into final evidence."
      },
      {
        "alternative": "use_banking77_or_clinc_test",
        "reason": "External test labels are not SentinelVoice taxonomy truth and do not encode its permission-sensitive semantics."
      },
      {
        "alternative": "mirror_natural_development_imbalance",
        "reason": "The development distribution would provide weak final evidence for newly discovered low-frequency intents."
      },
      {
        "alternative": "author_after_step22_errors",
        "reason": "Post-error generation would contaminate final evaluation with model-specific failure knowledge."
      }
    ],
    "chosen": "balanced_independently_authored_synthetic_final_holdout",
    "problem": "The prior V2-C4 holdout cannot provide valid acceptance evidence for the frozen 16-intent V2-C5 taxonomy.",
    "reversibility": "High before Step 23 final evaluation; a later evaluation version may use a separately governed holdout without rewriting this experiment.",
    "tradeoffs": [
      "Synthetic examples may not perfectly represent production traffic.",
      "Balanced class prevalence is not production prevalence.",
      "Forty examples per class provide finite statistical resolution.",
      "Independent authoring requires careful human review."
    ],
    "why_suitable": "A balanced synthetic holdout provides controlled, reproducible, inexpensive final evidence for every frozen intent while emphasizing permission-sensitive semantic boundaries."
  },
  "authorship_contract": {
    "author_may_know": [
      "frozen_v2c5_taxonomy_definitions",
      "frozen_permission_and_protected_action_semantics",
      "qualitative_boundary_coverage_requirements"
    ],
    "author_must_not_inspect_while_authoring": [
      "development_utterances",
      "historical_training_utterances",
      "consumed_evaluation_utterances",
      "v2c4_final_holdout_contents",
      "v2c5_model_predictions_or_errors"
    ],
    "authorship_method": "independently_authored_synthetic",
    "future_examples_authored_directly_for_known_gold_intent": true,
    "gold_label_determined_by_classifier_or_llm_prediction": false,
    "independent_from_development_examples": true,
    "prohibited_construction_methods": [
