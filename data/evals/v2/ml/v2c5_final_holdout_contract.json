      "use_cfpb",
      "copy_v2c3_challenge_records",
      "copy_v2c3_external_lockbox_records",
      "copy_v2c4_probe_augmentation_or_postmortem_records",
      "inspect_or_copy_sealed_v2c4_final_holdout",
      "use_v2c5_model_predictions_or_errors",
      "use_classifier_scores",
      "use_embedding_or_similarity_search_against_model_errors",
      "post_hoc_generation_targeted_to_step22_failures"
    ],
    "raw_future_holdout_text_present": false
  },
