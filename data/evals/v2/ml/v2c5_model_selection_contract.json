{
  "architecture_decision": {
    "alternatives_rejected": [
      {
        "alternative": "reuse_v2c3_bge_linear_svc_without_comparison",
        "reason": "The expanded 16-intent taxonomy materially changes the classification problem, so the historical winner must compete rather than be assumed optimal."
      },
      {
        "alternative": "transformer_fine_tuning_or_llm_classification",
        "reason": "These add cost, latency, and operational complexity before bounded local baselines establish a need."
      },
      {
        "alternative": "xgboost_or_lightgbm",
        "reason": "Tree boosting is not naturally advantaged on the frozen high-dimensional text representations."
      },
      {
        "alternative": "additional_embedding_models_or_providers",
        "reason": "Additional semantic representations are unnecessary until the bounded lexical-versus-BGE comparison is measured."
      },
      {
        "alternative": "hierarchical_classifier",
        "reason": "A hierarchy adds decision surfaces and error modes before direct 16-way baselines have been measured."
      }
    ],
    "chosen": "bounded_development_only_lexical_and_bge_linear_classifier_comparison",
    "problem": "The frozen 16-intent V2-C5 taxonomy changes the supervised classification problem, so the historical V2-C3 winner cannot be assumed optimal.",
    "reversibility": "High; Step 22 remains development-only and the sealed final holdout remains untouched until the once-only Step 23 evaluation.",
    "tradeoffs": [
      "The bounded grid may miss a globally optimal hyperparameter.",
      "TF-IDF representations have weaker semantic generalization than dense embeddings.",
      "BGE embedding generation costs more local CPU than sparse vectorization.",
      "Linear classifiers cannot learn arbitrary nonlinear decision boundaries."
    ],
    "why_suitable": [
      "strong_text_classification_baselines",
      "inexpensive_local_execution",
      "reproducible_and_auditable",
      "lexical_and_semantic_signal_comparison",
      "low_inference_cost",
      "appropriate_for_8198_examples"
    ]
  },
