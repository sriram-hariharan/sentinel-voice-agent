  },
  "schema_version": "v2c5-model-selection-contract.v1",
  "selection_rule": {
    "candidate_eligibility": "all_three_mandatory_safety_gates_pass",
    "if_no_candidate_passes": {
      "development_failure_reported": true,
      "final_holdout_accessed": false,
      "gates_weakened": false,
      "selected_candidate": null,
      "step23_permitted": false
    },
    "numerical_tie_tolerance": {
      "absolute": 1e-12,
      "relative": 0.0,
      "rule": "Treat numerical values as tied when absolute_difference <= absolute_tolerance; do not use raw floating-point equality."
    },
    "ordered_tie_breaks": [
      {
        "direction": "highest",
        "metric": "mean_fold_macro_f1"
      },
      {
        "direction": "highest",
        "metric": "worst_fold_macro_f1"
      },
      {
        "direction": "lowest",
        "metric": "protected_write_false_positive_rate"
      },
      {
        "direction": "highest",
        "metric": "unsupported_or_uncertain_recall"
      },
      {
        "direction": "lowest",
        "metric": "local_prediction_latency"
      },
      {
        "direction": "ascending_lexical",
        "metric": "candidate_id"
      }
    ]
  },
