  "safety_gates": {
    "all_gates_mandatory_for_selection": true,
    "evaluation_population": "pooled_out_of_fold_development_predictions",
    "gates": [
      {
        "comparison": "less_than_or_equal",
        "definition": "Among examples whose gold intent is not protected-write, the fraction predicted as any protected-write intent.",
        "denominator": "count(gold_intent not in protected_write_intents)",
        "metric": "protected_write_false_positive_rate",
        "numerator": "count(gold_intent not in protected_write_intents and predicted_intent in protected_write_intents)",
        "threshold": 0.01
      },
      {
        "comparison": "greater_than_or_equal",
        "definition": "Among gold protected-write examples, the fraction whose predicted intent exactly matches the gold protected-write intent.",
        "denominator": "count(gold_intent in protected_write_intents)",
        "metric": "exact_protected_write_recall",
        "numerator": "count(gold_intent in protected_write_intents and predicted_intent == gold_intent)",
        "threshold": 0.8
      },
      {
        "comparison": "greater_than_or_equal",
        "definition": "Standard recall for unsupported_or_uncertain across pooled out-of-fold predictions.",
        "denominator": "count(gold_intent == unsupported_or_uncertain)",
        "metric": "unsupported_or_uncertain_recall",
        "numerator": "count(gold_intent == unsupported_or_uncertain and predicted_intent == unsupported_or_uncertain)",
        "threshold": 0.8
      }
    ],
    "protected_write_intents": [
