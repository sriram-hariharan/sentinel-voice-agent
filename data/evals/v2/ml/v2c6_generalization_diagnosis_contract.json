{
  "allowed_remediation_recommendations": [
    "improve_training_data_diversity",
    "rebalance_development_data",
    "improve_group_or_source_independence",
    "improve_intent_definitions_or_boundaries",
    "hard_negative_generation",
    "unsupported_class_redesign",
    "reconsider_representation_or_classifier_family",
    "taxonomy_revision"
  ],
  "architecture_decision": {
    "alternatives_rejected": [
      {
        "alternative": "inspect_individual_v2c5_final_holdout_errors",
        "reason": "The once-only V2-C5 holdout is consumed and may remain historical aggregate evidence only."
      },
      {
        "alternative": "tune_or_select_from_v2c5_final_results",
        "reason": "Using consumed final evidence for selection would invalidate a future clean evaluation claim."
      },
      {
        "alternative": "begin_remediation_before_diagnosis_is_frozen",
        "reason": "A predeclared diagnostic boundary keeps evidence collection separate from remediation choices."
      }
    ],
    "chosen": "frozen_development_side_generalization_diagnosis",
    "problem": "V2-C5 development OOF evidence and once-only final evidence show a substantial generalization gap and failed protected-action safety gates without establishing a root cause.",
    "reversibility": "The diagnostic contract and future aggregate report are reversible; consumed final-holdout access and evidence leakage are not.",
    "tradeoffs": [
      "Development-side diagnosis can identify measurable concentration, dependence, imbalance, duplication, lexical, and boundary evidence but cannot directly inspect final-example failures.",
      "Incomplete provenance metadata may limit authoring-family conclusions.",
      "Observational associations can support diagnosis but do not by themselves establish causation."
    ]
  },
  "claim_policy": {
    "insufficient_alone_for_causal_or_root_cause_claim": [
      "class_imbalance_exists",
      "final_performance_dropped",
      "unsupported_or_uncertain_was_overpredicted"
    ],
    "levels": [
      {
        "definition": "A directly computed, reproducible statistic or relationship from an allowed frozen input.",
        "name": "observation"
      },
      {
        "definition": "A plausible explanation prompted by observations and labeled as unconfirmed.",
        "name": "hypothesis"
      },
      {
        "definition": "A hypothesis supported by explicitly reported, measurable development-side evidence from the predeclared analyses, with limitations and alternatives stated.",
        "name": "supported_diagnosis"
      },
      {
        "definition": "A claim that a factor caused the V2-C5 final outcome; Step 29B may not make this claim from observational diagnosis alone and would require a separately frozen causal design and evidence.",
        "name": "causal_claim"
      }
    ],
    "maximum_claim_authorized_by_step29b": "supported_diagnosis",
    "measurable_development_side_evidence_required_for_supported_diagnosis": true,
    "root_cause_claim_from_aggregate_final_metrics_only_permitted": false
  },
