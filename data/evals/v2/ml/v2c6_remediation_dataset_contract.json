      "translation_of_v2c5_final_holdout_example",
      "lexical_substitution_of_v2c5_final_holdout_example",
      "stylistic_variant_of_v2c5_final_holdout_example"
    ],
    "v2c5_final_holdout_may_be_used": false
  },
