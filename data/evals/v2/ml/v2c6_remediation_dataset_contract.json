{
  "architecture_decision": {
    "alternatives_rejected": [
      {
        "alternative": "generate_thousands_of_generic_synthetic_examples",
        "reason": "Generic scaling can repeat source-style bias, inflate cost, and obscure whether boundary quality improved."
      },
      {
        "alternative": "equalize_all_classes",
        "reason": "Blind class equality is not necessarily realistic and would discard or add evidence without a boundary-specific justification."
      },
      {
        "alternative": "immediately_swap_embedding_models",
        "reason": "A model change would confound the data-first remediation experiment selected in Step 29C."
      },
      {
        "alternative": "classifier_driven_adversarial_authoring",
        "reason": "Using current predictions to steer initial authoring risks model-targeted overfitting."
      },
      {
        "alternative": "reuse_failed_final_holdout_examples",
        "reason": "The V2-C5 final holdout is consumed evidence; reuse or paraphrase would destroy clean future evaluation."
      }
    ],
    "chosen": "bounded_independently_authored_metadata_rich_remediation_dataset_with_explicit_source_family_diversity_and_hard_negative_boundary_coverage",
    "problem": "V2-C5 development evidence generalized poorly despite strong group-aware cross-validation.",
    "reversibility": "High because Step 29D freezes dataset-construction rules only and creates no examples or datasets.",
    "suitability": [
      "addresses_measured_evidence_quality_risks_before_changing_models",
      "keeps_project_cost_bounded",
      "creates_auditable_source_independence",
      "improves_safety_sensitive_intent_boundaries",
      "enables_source_aware_development_evaluation",
      "preserves_the_existing_16_intent_runtime_contract"
    ],
    "tradeoffs": [
      "human_review_effort",
      "metadata_complexity",
      "independent_authoring_is_slower_than_paraphrasing",
      "source_family_constraints_complicate_dataset_construction",
      "810_new_records_may_still_not_be_sufficient"
    ]
  },
  "authoring_method_policy": {
    "allowed_methods": [
      "human_authored",
      "controlled_llm_assisted",
      "deterministic_scenario_or_template_generation_when_semantic_independence_is_preserved"
    ],
    "initial_authoring_may_use_current_classifier_predictions": false,
    "iterative_generation_until_current_classifier_is_right_or_wrong": false,
    "later_model_based_hard_example_mining_requires_separate_frozen_contract": true,
    "llm_assisted_examples_automatically_accepted": false,
    "prompt_instructions_are_ground_truth": false,
    "same_review_and_deduplication_pipeline_for_all_methods": true
  },
  "authoring_principle": {
    "author_from": [
      "semantic_intent_definitions",
      "human_reviewed_boundary_specifications"
    ],
    "independent_authoring_required": true,
    "prohibited_derivations": [
