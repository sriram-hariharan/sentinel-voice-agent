{
  "architecture_decision": {
    "alternatives_rejected_for_step29c": [
      {
        "alternative": "immediately_switch_embedding_model",
        "reason": "Changing representations before data and evaluation remediation would confound the experiment and is not supported as a proven V2-C5 root cause."
      },
      {
        "alternative": "tune_linearsvc_or_class_weights",
        "reason": "Step 29C does not select hyperparameters, and tuning against consumed final evidence would risk leakage."
      },
      {
        "alternative": "weaken_unsupported_handling_or_safety_gates",
        "reason": "The failed V2-C5 candidate does not justify weakening unsupported handling or any mandatory safety threshold."
      },
      {
        "alternative": "inspect_or_reuse_v2c5_final_holdout",
        "reason": "The V2-C5 final holdout is consumed historical evidence and cannot support clean future evaluation if inspected or reused."
      },
      {
        "alternative": "collapse_or_revise_taxonomy_immediately",
        "reason": "Step 29B observational evidence does not establish taxonomy ambiguity requiring a taxonomy change."
      }
    ],
    "chosen": "data_first_remediation_with_independent_source_diversity_hard_negative_boundaries_and_source_aware_development_evaluation",
    "problem": "V2-C5 achieved high group-aware development OOF performance but generalized poorly to an independently authored final evaluation and failed protected-action safety gates.",
    "reversibility": "Highly reversible because Step 29C freezes experiment design only and changes no data, model, taxonomy, thresholds, or runtime behavior.",
    "suitability": [
      "Step 29B measured negligible ordinary duplicate leakage.",
      "Step 29B measured source and authoring concentration.",
      "Step 29B measured supported-versus-unsupported errors in existing development OOF evidence.",
      "Several expanded intents have narrow development provenance.",
      "Evidence quality can be improved before changing model families."
    ],
    "tradeoffs": [
      "Independent authoring requires additional human effort.",
      "Source-aware splits reduce effective training data during development evaluation.",
      "Hard-negative authoring requires human boundary review.",
      "Explicit source-family metadata increases dataset complexity.",
      "Data-first remediation does not guarantee that a future model will pass."
    ]
  },
