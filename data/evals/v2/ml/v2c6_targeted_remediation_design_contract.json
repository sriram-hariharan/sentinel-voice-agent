  "architecture_decision": {
    "alternatives_considered": [
      {
        "alternative": "add_more_generic_examples",
        "decision": "rejected",
        "reason": "Measured failures are concentrated at specific supported/unsupported and protected-action boundaries."
      },
      {
        "alternative": "weaken_protected_false_positive_rate_gate",
        "decision": "rejected",
        "reason": "Changing the safety requirement after observing failures is prohibited."
      },
      {
        "alternative": "tune_thresholds_on_step29h_source_family_errors",
        "decision": "rejected",
        "reason": "Those errors are consumed diagnostic evidence, so post-hoc threshold tuning would overfit them."
      },
      {
        "alternative": "carry_balanced_class_weighting_forward",
        "decision": "not_chosen_for_this_bounded_search",
        "reason": "In the matched Step 29H comparisons, balanced weighting increased protected recall while also increasing protected false-positive rate and reducing unsupported recall; this is experiment-specific evidence, not a universal claim."
      },
      {
        "alternative": "immediately_add_larger_or_new_embedding_model",
        "decision": "not_chosen",
        "reason": "Hybridization and hierarchical decomposition test the measured problem with less cost and complexity first."
      },
      {
        "alternative": "immediately_proceed_to_step29i",
        "decision": "rejected",
        "reason": "No acceptable candidate exists."
      }
    ],
    "chosen": "targeted_boundary_remediation_plus_bounded_candidate_expansion_plus_fresh_source_family_evaluation",
    "problem_solved": "Step 29H failed safety generalization under previously unseen authoring styles, and Step 29H-B measured both data-boundary and representation/model evidence without proving a causal root cause.",
    "reversibility": "High; freezing this development plan changes no runtime, final model, taxonomy, dataset, or final holdout.",
    "tradeoffs": [
      "Authoring and review are required for 1240 new development records.",
      "The two fresh evaluation families become consumed development-selection evidence after one model-selection cycle.",
      "The hybrid and hierarchical candidates add modest implementation complexity.",
      "The bounded remediation has no guarantee of passing the frozen gates."
    ],
    "why_suitable_for_sentinelvoice": [
      "safety_first",
      "low_cost",
      "bounded_scope",
      "deterministic_evaluation",
      "interpretable_classical_ml_routing",
      "directly_tests_measured_failure_modes",
      "avoids_infrastructure_expansion"
    ]
  },
